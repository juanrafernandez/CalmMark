<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Enable App Sandbox -->
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- File Access: Allow user to select files/folders for read/write -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>

	<!-- Network: Required for WKWebView even with local content -->
	<!-- WKWebView uses out-of-process rendering and requires this entitlement -->
	<!-- See: https://developer.apple.com/forums/thread/116359 -->
	<key>com.apple.security.network.client</key>
	<true/>

	<!-- JIT: Required for JavaScript execution in WKWebView -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
